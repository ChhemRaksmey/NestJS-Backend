<div class="page-header">
  <h1>Products</h1>
  <a href="/products/create" class="btn btn-primary">+ New Product</a>
</div>

<table class="table">
  <thead>
    <tr>
      <th>#</th>
      <th>Name</th>
      <th>Price</th>
      <th>Created</th>
      <th class="actions-col">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if (products.length === 0) { %>
      <tr><td colspan="5" class="empty">No products yet.</td></tr>
    <% } %>
    <% products.forEach(function(p) { %>
      <tr>
        <td><%= p.id %></td>
        <td><%= p.name %></td>
        <td>$<%= Number(p.price).toFixed(2) %></td>
        <td><%= new Date(p.createdAt).toLocaleDateString() %></td>
        <td class="actions-col">
          <a href="/products/<%= p.id %>" class="btn btn-sm">View</a>
          <a href="/products/<%= p.id %>/edit" class="btn btn-sm">Edit</a>
          <form action="/products/<%= p.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this product?');">
            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>


<%-
  script = `<script></script>`;
%>
