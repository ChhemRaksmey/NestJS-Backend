<div class="auth-card">
  <h1>Login</h1>

  <% if (error) { %>
    <p class="alert alert-error"><%= error %></p>
  <% } %>

  <form action="/auth/login" method="POST" class="form">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required value="admin@mail.com" />

    <label for="password">Password</label>
    <input type="password" id="password" name="password" required value="123456789" />

    <button type="submit" class="btn btn-primary">Login</button>
  </form>

  <p class="muted">Don't have an account? <a href="/auth/register">Register here</a></p>
</div>

<style>
  .auth-card { max-width: 420px; margin: 60px auto; }
</style>
