<nav class="navbar">
  <a class="brand" href="/dashbord/default">NestJS CRUD App</a>
  <div class="nav-links">
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/">Products</a>
      <span class="nav-user">Hi, <%= user.name %></span>
      <form action="/auth/logout" method="POST" class="inline-form">
        <button type="submit" class="link-btn">Logout</button>
      </form>
    <% } else { %>
      <a href="/auth/login">Login</a>
      <a href="/auth/register">Register</a>
    <% } %>
  </div>
</nav>
